# Step 3: money. The model proposes; the program pays, once.
#
# - `refund` is a `write` with an idempotency key: retried or resumed after
#   a crash, it never pays twice.
# - `requires`: the store checks these on the order as it is when it pays.
# - `email` is `write once`: if its answer is lost, Calyx asks `email_sent`
#   before deciding to send it again.
# - `notice after paid`: the e-mail goes out only after the refund.
#
#   calyx run 3_refund.clyx --fake-models --request R1 --order A100 --message "It arrived broken"

model gemini = "gemini-3.5-flash-lite"

type Status = Pending | Delivered | Cancelled

type Order:
    id: Text
    customer: Text
    email: Text
    total: Float
    refunded: Float
    status: Status

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Proposal:
    amount: Float
    reason: Text

tool get_order(id: Text) -> Order:
    effect read

tool refund(request: Text, order: Text, amount: Float) -> Unit:
    effect write
    idempotency_key request
    checks OrderState

tool email_sent(to: Text, subject: Text) -> Bool:
    effect read

tool email(to: Text, subject: Text, body: Text) -> Unit:
    effect write once
    timeout 10 s
    on_uncertain verify(email_sent(to, subject))

prompt decide(order: Order, message: Text) -> Proposal:
    """
    A customer asked for a refund. Propose an amount that, with what was
    already refunded ({order.refunded}), is not over {order.total}, and say
    why in one sentence.

    Order: {order}
    Message: {message}
    """

prompt reply(order: Order, amount: Float) -> Text:
    """
    Write a short e-mail to {order.customer} confirming a refund of
    {amount} for order {order.id}.
    """

graph refund_request(request: Text, order: Text, message: Text) -> Text:
    found = get_order(order)
    proposal = gemini(decide(found, message))

    paid = refund(request, order, proposal.amount):
        requires state.status == Delivered
        requires state.refunded + proposal.amount <= state.total

    body = gemini(reply(found, proposal.amount))
    notice = email(found.email, "Refund of order {order}", body)
    notice after paid

    return "refunded {proposal.amount} to {found.email}"
