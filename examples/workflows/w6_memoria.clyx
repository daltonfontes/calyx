# W6. Assistente com memória entre sessões
# Força: estado persistente, execuções simultâneas do mesmo usuário (D15),
#        resultado antecipado (D19), mensagens entre execuções (D21).

model claude = "claude-sonnet-5-5":
    max_output 1500 tokens

type Fact:
    key: Text
    content: Text

prompt answer(history: Conversation, memories: List[Fact], text: Text) -> Text:
    """
    Você conhece estes fatos sobre o usuário: {memories}
    Responda à mensagem: {text}
    """

prompt facts_from(history: Conversation) -> List[Fact] max 5:
    """
    Extraia da conversa até 5 fatos novos e duradouros sobre o usuário.
    {history}
    """

# "entity": uma execução de vida longa, no máximo uma aberta por chave (D15).
# Ela é a DONA da memória do usuário. Outras execuções não gravam direto:
# mandam mensagens, que ela processa uma de cada vez.
entity UserMemory(key user: UserId):
    state facts: Map[Text, Fact] = empty

    # Consulta: resposta síncrona, não altera o estado; roda em paralelo com outras.
    on Recall(query: Text) -> List[Fact]:
        return search(facts, query, limit=10)

    # Escrita: altera o estado, uma de cada vez; cada mensagem vai para o diário.
    on Remember(new: List[Fact]):
        next facts = facts.merge(new, by="key")

graph chat(user: UserId, history: Conversation, text: Text) -> Text:
    limits budget 0.20 USD

    memories = ask UserMemory(user).Recall(text)
    reply = claude(answer(history, memories, text), continue=history)

    # Resultado antecipado (D19): o usuário recebe a resposta já aqui.
    # O resto do grafo continua em segundo plano.
    respond reply.value

    learned = claude(facts_from(reply.conversation))
    send UserMemory(user).Remember(learned)

    # Um grafo com "respond" não tem "return": o valor entregue é o do respond.
