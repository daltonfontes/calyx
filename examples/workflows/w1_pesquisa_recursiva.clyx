# W1. Pesquisa profunda recursiva
# Força: fan-out aninhado, recursão de subgrafos (D17), teto de custo calculado.

model claude = "claude-sonnet-5-5":
    max_output 2000 tokens

tool web_search(query: Text) -> Text:
    effect read
    max_output 4000 tokens
    retry_on [Timeout, RateLimit]

type Learning:
    facts: List[Text]
    next_directions: List[Text] max 4

prompt queries(topic: Text, breadth: Nat) -> List[Text] max 8:
    """
    Gere até {breadth} consultas de busca diferentes para investigar: {topic}
    """

prompt learn(query: Text, results: Text) -> Learning:
    """
    A partir dos resultados da busca "{query}", extraia fatos e até 4 direções
    que merecem aprofundamento.

    {results}
    """

prompt report(topic: Text, facts: List[Text]) -> Text:
    """
    Escreva um relatório sobre "{topic}" com base nestes fatos:
    {facts}
    """

# "decreases depth": o compilador exige que toda chamada recursiva passe um depth menor.
graph deep_research(topic: Text, depth: Nat max 3, breadth: Nat max 8) -> List[Text]:
    decreases depth

    qs = claude(queries(topic, breadth))

    learned = for each q in qs:
        claude(learn(q, web_search(q)))

    # Recursão: um subgrafo por direção nova, com profundidade e largura menores.
    deeper = for each l in learned:
        if depth > 1:
            # Fan-out dentro de fan-out dá lista de listas: o flatten é explícito.
            flatten(for each d in l.next_directions: deep_research(d, depth - 1, breadth / 2))
        else:
            []

    # Junção: concatena na ordem das consultas (D7); deduplicar é um passo puro.
    return dedupe(concat(learned.facts) + concat(deeper))

graph main(topic: Text) -> Text:
    # Com depth ≤ 3 e breadth ≤ 8 (8 → 4 → 2), o compilador calcula o número máximo
    # de passos e um teto de custo antes de rodar.
    limits threads 16, budget 10 USD

    facts = deep_research(topic, 3, 8)
    return claude(report(topic, facts))
