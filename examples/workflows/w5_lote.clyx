# W5. Extração em lote (1000 documentos)
# Força: escala, limites, falha parcial como valor (D11), retentativa derivada do efeito.

model claude = "claude-haiku-4-5":
    max_output 800 tokens

tool load_documents(folder: Text) -> List[Document]:
    effect read

tool write_sheet(path: Text, rows: List[Contract]) -> Unit:
    effect write
    idempotency_key path

type Contract:
    parties: List[Text]
    value: Money
    signed_at: Date

type Summary:
    extracted: Nat
    failed: List[Failure]

prompt extract(doc: Document) -> Contract:
    """
    Extraia partes, valor e data de assinatura do contrato abaixo.

    {doc.text}
    """

prompt correct(doc: Document, attempt: Contract, problems: List[Text]) -> Contract:
    """
    A extração abaixo tem problemas: {problems}
    Corrija usando o documento original.

    Extração: {attempt}
    Documento: {doc.text}
    """

# Função pura: sem efeito, o compilador sabe que pode recalcular à vontade.
# Cada "problems = ..." cria um valor novo; nada é alterado no lugar.
def check(c: Contract) -> List[Text]:
    problems = []
    if len(c.parties) < 2:
        problems = problems + ["menos de duas partes"]
    if c.value <= 0 BRL:
        problems = problems + ["valor inválido"]
    return problems

graph batch(folder: Text) -> Summary:
    # Concorrência controlada só pelos limites. Retentativa de erros temporários
    # (limite de requisições, erro 500) é automática porque os passos são llm/read.
    limits threads 20, rate 50/s, budget 30 USD

    docs = load_documents(folder)

    # "try": o resultado de cada item é um valor Ok(...) ou Failed(...) (D11).
    # A falha de um documento não derruba os outros 999.
    contracts = for each d in docs:
        try:
            loop c = claude(extract(d)), max 2:
                match check(c):
                    case []:
                        done c
                    case problems:
                        next claude(correct(d, c, problems))
                on limit: fail "continua inválido após 2 correções"

    # O compilador obriga a separar as duas variantes antes de usar a lista.
    good = contracts.ok()
    failed = contracts.failed()

    sheet = write_sheet("{folder}/contratos.xlsx", good)

    return Summary(extracted=len(good), failed=failed)

# Se o orçamento acabar no meio, a execução pausa e pode ser retomada com mais
# orçamento; os documentos já extraídos vêm do diário.
