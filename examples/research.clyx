# research.clyx
# Pesquisa um tema em paralelo e escreve um relatório.
# Usa só o que o compilador e o runtime já suportam (marcos M1 e M2).
#
#   calyx check examples/research.clyx --ir
#   calyx run examples/research.clyx --fake-models --topic "energia solar"   # sem rede
#   GEMINI_API_KEY=... calyx run examples/research.clyx --topic "energia solar"
#
# A tool web_search roda no servidor MCP configurado em examples/calyx.toml.

model gemini = "gemini-3.5-flash-lite":
    max_output 2000 tokens

tool web_search(query: Text) -> Text:
    effect read
    max_output 4000 tokens
    timeout 30 s
    retry_on [Timeout, RateLimit]

type Plan:
    questions: List[Text] max 5

prompt split_topic(topic: Text) -> Plan:
    """
    Divida o tema abaixo em até 5 perguntas de pesquisa independentes.

    Tema: {topic}
    """

prompt summarize(question: Text, results: Text) -> Text:
    """
    Responda à pergunta usando apenas os resultados de busca, citando as fontes.

    Pergunta: {question}
    Resultados: {results}
    """

prompt write_report(topic: Text, findings: List[Text]) -> Text:
    """
    Escreva um relatório sobre "{topic}" usando apenas as descobertas abaixo.

    {findings}
    """

graph research(topic: Text) -> Text:
    effect read                       # garante que este grafo nunca escreve no mundo
    limits threads 8, budget 2 USD

    plan = gemini(split_topic(topic))

    # Sem "parallel": cada pergunta é buscada e resumida de forma independente,
    # então o runtime roda até 8 ao mesmo tempo.
    answers = for each q in plan.questions:
        gemini(summarize(q, web_search(q)))

    return gemini(write_report(topic, answers))
