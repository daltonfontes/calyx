# Como era antes de `race first N`: o quórum só podia esperar as 3 respostas.
model a = "fake-model"
model b = "fake-slow-300"
model c = "fake-slow-2000"

prompt ask(q: Text) -> Text:
    """{q}"""

prompt combine(xs: List[Text]) -> Text:
    """{xs}"""

graph g(q: Text) -> Text:
    answers = [a(ask(q)), b(ask(q)), c(ask(q))]
    return a(combine(take(answers, 2)))
