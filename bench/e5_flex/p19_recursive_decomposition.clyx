# Padrão: decomposição recursiva (dividir a tarefa em subtarefas até ficarem simples).
model m = "fake-model"

prompt split(t: Text) -> List[Text] max 3:
    """{t}"""

prompt solve(t: Text) -> Text:
    """{t}"""

prompt merge(xs: List[Text]) -> Text:
    """{xs}"""

graph work(task: Text, depth: Nat) -> Text:
    decreases depth
    answer = if depth == 0:
        m(solve(task))
    else:
        parts = m(split(task))
        subs = for each p in parts:
            work(p, depth - 1)
        m(merge(subs))
    return answer
