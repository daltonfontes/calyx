# Padrão: quórum, perguntar a 3 modelos e seguir com as 2 primeiras respostas.
# Não há como dizer "as 2 primeiras a chegar": `take` pega as 2 primeiras da lista,
# e a lista só existe quando as 3 chegam.
model a = "fake-model"
model b = "fake-slow-300"
model c = "fake-slow-2000"

prompt ask(q: Text) -> Text:
    """{q}"""

prompt combine(xs: List[Text]) -> Text:
    """{xs}"""

graph g(q: Text) -> Text:
    answers = [a(ask(q)), b(ask(q)), c(ask(q))]
    return a(combine(take(answers, 2)))
