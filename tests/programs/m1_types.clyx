# Type errors.
model claude = "m"

type Plan:
    questions: List[Text] max 5
    owner: Pessoa

tool search(q: Text, limit: Nat) -> Text:
    effect read

prompt split(topic: Text) -> Plan:
    """{topic}"""

graph g(topic: Text, n: Nat) -> Nat:
    plan = claude(split(topic))
    a = search(n, 3)
    b = search(topic)
    c = search(topic, 3, 4)
    d = plan.missing
    e = for each x in topic: search(x, 1)
    f = [topic, n]
    out = search(topic, limit=2)
    return out
