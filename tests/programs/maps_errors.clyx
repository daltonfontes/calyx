# A map's keys are texts (or variants without fields); `[...]` reads only
# maps and lists; a map's values are of one type.

type Order:
    id: Text

graph a(m: Map[Nat, Text]) -> Text:
    return "x"

graph b(name: Text) -> Text:
    return name[0]

graph c(m: Map[Text, Nat]) -> Nat:
    return m[3]

graph d() -> Map[Text, Nat]:
    return {"a": 1, "b": "dois"}

graph e(o: Order) -> Map[Order, Nat]:
    return {o: 1}
