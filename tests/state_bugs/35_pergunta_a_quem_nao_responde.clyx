# Bug: `ask` a uma mensagem que muda o estado e não responde nada.
# Pego por: E0656
model m = "m"

entity Account(key id: Text):
    state balance: Int = 0
    state history: List[Text] = []

    on Balance() -> Int:
        return balance

    on Deposit(amount: Int, note: Text):
        next balance = balance + amount
        next history = history + [note]

    on Set(amount: Int):
        next balance = amount

prompt why(x: Text) -> Text:
    """{x}"""

graph g(id: Text) -> Int:
    r = ask Account(id).Deposit(10, "x")
    return 0
