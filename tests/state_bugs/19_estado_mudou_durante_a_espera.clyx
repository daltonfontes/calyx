# Bug: O pedido foi cancelado entre a decisão e o reembolso (a decisão viu um estado antigo).
# Pego por: runtime
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool refund(request: Text, order: Text, amount: Float) -> Unit:
    effect write
    idempotency_key request
    checks OrderState

graph g(request: Text, id: Text) -> Text:
    o = get_order(id)
    amount = m(decide(o))
    paid = refund(request, id, amount):
        requires state.status == Delivered
        requires state.refunded + amount <= state.total
    return "ok"
