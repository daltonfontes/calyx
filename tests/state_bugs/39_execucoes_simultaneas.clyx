# Bug: Várias execuções do mesmo usuário depositam ao mesmo tempo.
# Pego por: runtime
model m = "m"

entity Account(key id: Text):
    state balance: Int = 0
    state history: List[Text] = []

    on Balance() -> Int:
        return balance

    on Deposit(amount: Int, note: Text):
        next balance = balance + amount
        next history = history + [note]

    on Set(amount: Int):
        next balance = amount

prompt why(x: Text) -> Text:
    """{x}"""

graph g(id: Text) -> Text:
    send Account(id).Deposit(1, "x")
    return "ok"
