# Bug: Precondição escrita numa tool que não sabe verificá-la: seria ignorada em silêncio.
# Pego por: E0636
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool refund(request: Text, order: Text, amount: Float) -> Unit:
    effect write
    idempotency_key request

graph g(request: Text, id: Text) -> Text:
    o = get_order(id)
    paid = refund(request, id, 10.0):
        requires state.status == Delivered
    return "ok"
