# Bug: A verificação consulta algo que não identifica a chamada incerta.
# Pego por: E0632
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool sent_to(to: Text) -> Bool:
    effect read

tool email(to: Text, text: Text) -> Unit:
    effect write once
    on_uncertain verify(sent_to(order))

graph g(id: Text) -> Text:
    o = get_order(id)
    sent = email(o.email, "oi")
    return "ok"
