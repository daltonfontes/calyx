# Bug: Duas escritas, cada uma esperando a outra: a execução nunca terminaria.
# Pego por: E0506
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool refund(request: Text, order: Text, amount: Float) -> Unit:
    effect write
    idempotency_key request
    checks OrderState

tool email(to: Text, text: Text) -> Unit:
    effect write once
    on_uncertain pause

graph g(request: Text, id: Text) -> Text:
    o = get_order(id)
    paid = refund(request, id, 10.0)
    sent = email(o.email, "reembolsado")
    sent after paid
    paid after sent
    return "ok"
