# Bug: Precondição sobre um campo que o estado não tem (erro de digitação): nunca seria verdadeira.
# Pego por: E0603
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool refund(request: Text, order: Text, amount: Float) -> Unit:
    effect write
    idempotency_key request
    checks OrderState

graph g(request: Text, id: Text) -> Text:
    paid = refund(request, id, 10.0):
        requires state.stauts == Delivered
    return "ok"
