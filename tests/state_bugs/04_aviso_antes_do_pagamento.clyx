# Bug: O e-mail de confirmação pode sair antes do reembolso (ou sem ele, se o reembolso falhar).
# Pego por: W0602
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool refund(request: Text, order: Text, amount: Float) -> Unit:
    effect write
    idempotency_key request
    checks OrderState

tool email(to: Text, text: Text) -> Unit:
    effect write once
    on_uncertain pause

graph g(request: Text, id: Text) -> Text:
    o = get_order(id)
    amount = m(decide(o))
    paid = refund(request, id, amount)
    sent = email(o.email, "reembolsado: {amount}")
    return "ok"
