# Bug: O processo cai depois de mandar o e-mail e antes de receber a resposta; a retomada reenviaria.
# Pego por: runtime
model m = "m"

type Status = Pending | Delivered | Cancelled

type OrderState:
    status: Status
    total: Float
    refunded: Float

type Order:
    id: Text
    email: Text
    total: Float
    status: Status

tool get_order(id: Text) -> Order:
    effect read

prompt decide(o: Order) -> Float:
    """Quanto reembolsar de {o}?"""

tool email(to: Text, text: Text) -> Unit:
    effect write once
    on_uncertain pause

graph g(id: Text) -> Text:
    o = get_order(id)
    sent = email(o.email, "oi")
    return "ok"
