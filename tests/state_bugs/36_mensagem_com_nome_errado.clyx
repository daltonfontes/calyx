# Bug: `send` para uma mensagem que a entidade não trata (erro de digitação): o depósito sumiria.
# Pego por: E0655
model m = "m"

entity Account(key id: Text):
    state balance: Int = 0
    state history: List[Text] = []

    on Balance() -> Int:
        return balance

    on Deposit(amount: Int, note: Text):
        next balance = balance + amount
        next history = history + [note]

    on Set(amount: Int):
        next balance = amount

prompt why(x: Text) -> Text:
    """{x}"""

graph g(id: Text) -> Text:
    send Account(id).Deposti(10, "x")
    return "ok"
